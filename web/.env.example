# ---- Supabase (project: jobs-ai / xrbnekghcswgotsauxok) ----
NEXT_PUBLIC_SUPABASE_URL=https://xrbnekghcswgotsauxok.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_shSOwwHUzFv_7MH9iM3u_w_Sm0CzSIg
# Server only. Dashboard -> Project Settings -> API keys -> service_role. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
# Model for the job agent. Keep claude-opus-5-5 unless you have measured a cheaper one.
AGENT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (medium is the documented starting point on Opus 5.5)
AGENT_EFFORT=medium
# Max model calls per user turn (each tool round trip is one call).
AGENT_MAX_CALLS=8

# ---- Credits ----
# Multiplier on Anthropic list price. 1.5 covers Stripe fees on a $5 pack and leaves margin.
CREDIT_MARKUP=1.5
# A turn is refused when the balance is below this (micro-dollars; 50000 = $0.05).
CREDIT_TURN_RESERVE_MICROS=50000
# Optional trial credit for new accounts, in cents. 0 = none.
WELCOME_CREDIT_CENTS=0

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public origin used for Checkout return URLs, e.g. https://jobs.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
